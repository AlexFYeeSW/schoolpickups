{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schoolpickups",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",

  // The web pages in /public are served directly; /api/* goes to the Worker code.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Cloudflare cron runs on UTC. 12:00 PM in Los Angeles is 19:00 UTC in summer
  // (PDT) and 20:00 UTC in winter (PST), so both fire Mon-Fri and the Worker
  // only acts on the one that is actually 12 PM local time.
  "triggers": {
    "crons": ["0 19,20 * * 1-5"]
  },

  // Keep variables added in the dashboard when deploying (secrets are always kept).
  "keep_vars": true,

  "vars": {
    "TIMEZONE": "America/Los_Angeles",
    "SEND_HOUR": "12",
    "NVIDIA_MODEL": "meta/llama-3.3-70b-instruct"
  },

  // At most 30 AI requests per minute per visitor (protects the Nvidia bill).
  "ratelimits": [
    { "name": "LLM_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],

  "observability": { "enabled": true }

  // Secrets (set in the Cloudflare dashboard as type Secret, never in this file):
  //   NVIDIA_API_KEY, SUPABASE_URL, SUPABASE_SECRET_KEY
}
